# Lokal: salin ke .env lalu isi (sudah di-.gitignore).
# Dokploy: isi variabel yang sama di tab Environment aplikasi.
AUTH_USERNAME=admin
AUTH_PASSWORD=ganti-dengan-password-kuat
# Kunci penanda cookie sesi (wajib di produksi agar sesi tidak hangus saat restart).
# Buat dengan: python3 -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
# Opsional: lama sesi (jam), default 12
# AUTH_SESSION_HOURS=12
# Opsional: masa berlaku link berbagi slip (hari), default 30
# SHARE_TTL_DAYS=30

# Opsional (sudah di-set di Dockerfile): PORT=8000, DATA_DIR=/data, CHROME_PATH=/usr/bin/chromium
